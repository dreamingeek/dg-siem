<!--
  DG SIEM cold tier: a "tiered" storage policy with local disk ("hot") and an S3-compatible bucket ("cold").
  Turned on by docker-compose.s3.yml, which mounts this file and passes the DGSIEM_S3_* variables from .env.
  Administration > Storage then moves events older than N days to the bucket; they stay searchable.

  DGSIEM_S3_ENDPOINT is the bucket URL plus a folder, ending in "/", e.g.
    Backblaze B2: https://s3.us-west-004.backblazeb2.com/my-bucket/dg-siem/
    Wasabi:       https://s3.us-east-1.wasabisys.com/my-bucket/dg-siem/
    MinIO:        http://minio.lan:9000/my-bucket/dg-siem/
  Use a bucket (or folder) only for this: ClickHouse names the objects itself and they're useless on their own.
-->
<clickhouse>
    <storage_configuration>
        <disks>
            <s3_cold>
                <type>s3</type>
                <endpoint from_env="DGSIEM_S3_ENDPOINT" />
                <access_key_id from_env="DGSIEM_S3_ACCESS_KEY_ID" />
                <secret_access_key from_env="DGSIEM_S3_SECRET_ACCESS_KEY" />
                <metadata_path>/var/lib/clickhouse/disks/s3_cold/</metadata_path>
                <!-- Some S3-compatible services (B2, GCS) don't do batch deletes; single deletes work everywhere. -->
                <support_batch_delete>false</support_batch_delete>
            </s3_cold>
            <!-- Local cache in front of the bucket, so repeated searches over old data don't re-download it. -->
            <s3_cold_cache>
                <type>cache</type>
                <disk>s3_cold</disk>
                <path>/var/lib/clickhouse/disks/s3_cold_cache/</path>
                <max_size>10Gi</max_size>
            </s3_cold_cache>
        </disks>
        <policies>
            <tiered>
                <!-- Safety valve: when the local disk is under 10% free, ClickHouse also moves parts to cold early
                     (newest included) rather than running out of space. -->
                <move_factor>0.1</move_factor>
                <volumes>
                    <!-- Must be named "default": ClickHouse only lets a table switch to a policy that keeps its old volumes. -->
                    <default>
                        <disk>default</disk>
                    </default>
                    <cold>
                        <disk>s3_cold_cache</disk>
                    </cold>
                </volumes>
            </tiered>
        </policies>
    </storage_configuration>
</clickhouse>
