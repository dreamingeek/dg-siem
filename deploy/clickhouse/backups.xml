<!--
  DG SIEM event backups: ClickHouse writes them (BACKUP ... TO Disk('backups', 'events-....zip')) into /backups,
  which docker-compose.yml maps to ${DGSIEM_BACKUP_DIR}/events on the host. Administration > Backups.
-->
<clickhouse>
    <storage_configuration>
        <disks>
            <backups>
                <type>local</type>
                <path>/backups/</path>
            </backups>
        </disks>
    </storage_configuration>
    <backups>
        <allowed_disk>backups</allowed_disk>
        <allowed_path>/backups/</allowed_path>
    </backups>
</clickhouse>
