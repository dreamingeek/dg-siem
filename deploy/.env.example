# Copy to .env and fill in. docker compose refuses to start while a required value is empty.
# Generate passwords with: openssl rand -base64 24

# Required: database passwords (set once; changing them later means changing them in the databases too).
POSTGRES_PASSWORD=
CLICKHOUSE_PASSWORD=

DGSIEM_HTTP_PORT=8080
DGSIEM_AGENT_PORT=8443
# The name agents use to reach the agent port, e.g. siem-agents.example.com. Put it in the agents' --server URL.
DGSIEM_AGENT_HOSTNAME=localhost
# Optional second name or address for the agent port, e.g. the server's LAN address.
DGSIEM_AGENT_HOSTNAME_INTERNAL=

# Nightly backups (docs/backups.md). Config backups are encrypted with this passphrase (12+ characters);
# store it in your password manager too.
DGSIEM_BACKUP_PASSPHRASE=
# Host folder for backups, with config/ and events/ inside (docs/backups.md).
DGSIEM_BACKUP_DIR=./backups
