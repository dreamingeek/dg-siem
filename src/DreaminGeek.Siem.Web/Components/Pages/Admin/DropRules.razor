@page "/admin/drop-rules"
@rendermode InteractiveServer
@using System.Globalization
@using DreaminGeek.Siem.Web.Admin
@using DreaminGeek.Siem.Web.Agents
@using DreaminGeek.Siem.Web.Security
@inject AdminService Admin
@inject TenantAccess Access

<PageTitle>Drop rules · DG SIEM</PageTitle>

<div class="dg-page-head">
    <h1>Drop rules</h1>
    <p>Events matching a rule are discarded on arrival and never stored. Changes apply within 30 seconds.</p>
</div>

<AdminOnly Access="_access">
    @if (_error is not null)
    {
        <div class="alert alert-danger small" role="alert">@_error</div>
    }

    <section class="dg-panel mb-3">
        <header><h2>Add a rule</h2></header>
        <div class="dg-body">
            <form class="row g-2 align-items-end" @onsubmit="AddAsync" @onsubmit:preventDefault>
                <div class="col-md-3">
                    <label class="form-label small" for="rname">Name</label>
                    <input id="rname" class="form-control form-control-sm" placeholder="UniFi IPsec keepalives" @bind="_name" />
                </div>
                <div class="col-md-2">
                    <label class="form-label small" for="rtenant">Tenant</label>
                    <select id="rtenant" class="form-select form-select-sm" @bind="_tenant">
                        <option value="">All tenants</option>
                        @foreach (var t in _tenants)
                        {
                            <option value="@t.Slug">@t.Slug</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label small" for="rds">Dataset</label>
                    <input id="rds" class="form-control form-control-sm" placeholder="unifi.vpn or unifi.*" @bind="_dataset" />
                </div>
                <div class="col-md-2">
                    <label class="form-label small" for="rfield">Field</label>
                    <input id="rfield" class="form-control form-control-sm" placeholder="event.action" @bind="_field" />
                </div>
                <div class="col-md-1">
                    <label class="form-label small" for="rmatch">Match</label>
                    <select id="rmatch" class="form-select form-select-sm" @bind="_match">
                        <option value="any">(whole dataset)</option>
                        <option value="equals">equals</option>
                        <option value="contains">contains</option>
                        <option value="startswith">starts with</option>
                        <option value="regex">regex</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label small" for="rvalue">Value</label>
                    <input id="rvalue" class="form-control form-control-sm" placeholder="ipsec_keepalive" @bind="_value" disabled="@(_match == "any")" />
                </div>
                <div class="col-12 text-end">
                    <button class="btn btn-sm btn-primary" type="submit">Add rule</button>
                </div>
            </form>
        </div>
    </section>

    <section class="dg-panel">
        <div class="table-responsive">
            <table class="table">
                <thead><tr><th>Rule</th><th>Tenant</th><th>Dataset</th><th>Condition</th><th class="num">Dropped</th><th>Last dropped</th><th></th></tr></thead>
                <tbody>
                    @foreach (var r in _rules)
                    {
                        <tr class="@(r.Enabled ? "" : "text-body-secondary")">
                            <td>@r.Name @(r.Enabled ? "" : "(off)")</td>
                            <td>@(r.Tenant ?? "all")</td>
                            <td>@(r.Dataset ?? "any")</td>
                            <td class="dg-log">@(r.Field is null ? "every event" : $"{r.Field} {MatchText(r.Match)} \"{r.Value}\"")</td>
                            <td class="num">@r.Dropped.ToString("N0", CultureInfo.InvariantCulture)</td>
                            <td class="text-nowrap">@(r.LastDropped is null ? "never" : AgentHealth.Ago(r.LastDropped))</td>
                            <td class="text-end text-nowrap">
                                <button type="button" class="btn btn-sm btn-link" @onclick="() => ToggleAsync(r)">@(r.Enabled ? "Turn off" : "Turn on")</button>
                                @if (_confirmDelete == r.Id)
                                {
                                    <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => DeleteAsync(r)">Confirm delete</button>
                                }
                                else
                                {
                                    <button type="button" class="btn btn-sm btn-link text-danger" @onclick="() => _confirmDelete = r.Id">Delete</button>
                                }
                            </td>
                        </tr>
                    }
                    @if (_rules.Count == 0)
                    {
                        <tr><td colspan="7" class="text-body-secondary">No rules: every event is stored. Add one above to discard noise such as IPsec keepalives.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
</AdminOnly>

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = default!;

    private UserAccess? _access;
    private IReadOnlyList<DropRuleSummary> _rules = [];
    private IReadOnlyList<TenantSummary> _tenants = [];
    private string? _error;
    private Guid? _confirmDelete;

    private string _name = string.Empty;
    private string _tenant = string.Empty;
    private string _dataset = string.Empty;
    private string _field = string.Empty;
    private string _match = "any";
    private string _value = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        _access = await Access.GetAsync((await AuthState).User, CancellationToken.None);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (_access?.IsGlobalAdmin != true)
        {
            return;
        }
        _rules = await Admin.ListDropRulesAsync(_access, CancellationToken.None);
        _tenants = await Admin.ListTenantsAsync(_access, CancellationToken.None);
    }

    private async Task Run(Func<Task> action)
    {
        _error = null;
        try
        {
            await action();
            await LoadAsync();
        }
        catch (AdminException ex)
        {
            _error = ex.Message;
        }
    }

    private Task AddAsync() => Run(async () =>
    {
        await Admin.AddDropRuleAsync(_access, _name, _tenant, _dataset, _match == "any" ? null : _field, _match, _value, CancellationToken.None);
        _name = _dataset = _field = _value = string.Empty;
        _match = "any";
    });

    private Task ToggleAsync(DropRuleSummary rule) => Run(() => Admin.SetDropRuleEnabledAsync(_access, rule.Id, !rule.Enabled, CancellationToken.None));

    private Task DeleteAsync(DropRuleSummary rule) => Run(async () =>
    {
        await Admin.DeleteDropRuleAsync(_access, rule.Id, CancellationToken.None);
        _confirmDelete = null;
    });

    private static string MatchText(string match) => match switch
    {
        "startswith" => "starts with",
        "regex" => "matches",
        _ => match,
    };
}
