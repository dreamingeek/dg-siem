{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=dgsiem;Username=dgsiem;Password=change-me"
  },
  "ClickHouse": {
    "ConnectionString": "Host=localhost;Port=8123;Username=dgsiem;Password=change-me;Database=dgsiem",
    "Database": "dgsiem",
    "ApplyMigrations": true
  },
  "Ingest": {
    "QueueCapacity": 200000,
    "BatchSize": 10000,
    "FlushInterval": "00:00:01"
  },
  "Server": {
    "HttpPort": 8080,
    "AgentPort": 8443,
    "KeysDirectory": "/var/lib/dg-siem/keys",
    "AgentPublicUrl": ""
  },
  "Pki": {
    "Directory": "/var/lib/dg-siem/pki",
    "AgentHostnames": [
      "localhost"
    ],
    "AgentCertificateDays": 365,
    "ServerCertificateDays": 397
  }
}
